set_global_assignment -name SYSTEMVERILOG_FILE hamming_window.sv
set_global_assignment -name VERILOG_FILE rom_ip.v
set_global_assignment -name VERILOG_FILE audio_pll.v
set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id peak_tracking_test
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id peak_tracking_test
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to CLOCK_50 -section_id peak_tracking_test
